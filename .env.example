# Optional Anthropic Messages API. External requests also require per-request UI consent.
MINDMATE_DB_PATH=data/mindmate.sqlite3
MINDMATE_LLM_ENABLED=false
MINDMATE_LLM_API_KEY=
MINDMATE_LLM_MODEL=

# Model ID must support JSON structured outputs on your Anthropic account.
MINDMATE_LLM_TIMEOUT_SECONDS=20

# Keep false for normal use. The opt-in demo uses a separate ignored database.
MINDMATE_DEMO_MODE=false

# Required in profile mode. Comma-separated Fernet keys; first encrypts. Keep private.
MINDMATE_ENCRYPTION_KEYS=
# Unsafe for shared/public deployment; only for preserved unassigned local data.
MINDMATE_LEGACY_LOCAL=false
